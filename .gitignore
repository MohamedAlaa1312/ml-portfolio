# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment Variables & Secrets (NEVER commit secrets or real env files)
.env
.env*.local
.env.development
.env.test
.env.production
.env*
!.env.example

# Next.js Build Output & Caches
/.next/
/out/
/build/
/dist/
.turbo/

# Testing & Coverage
/coverage

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel & Hosting
.vercel

# IDE & Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Security & Private Certificates
*.pem
*.key
*.cert
*.crt

# Local Media Uploads (Preserve directory structure, ignore uploaded files)
/public/uploads/*
!/public/uploads/.gitkeep
