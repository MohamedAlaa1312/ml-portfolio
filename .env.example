# ==============================================================================
# ML ENGINEER PORTFOLIO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in your production hosting platform (e.g. Vercel).
# NEVER commit real credentials, passwords, or service-role keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE CONFIGURATION (Exposed to browser bundle)
# ------------------------------------------------------------------------------
# Supabase project URL from: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public Anon API key (Protected by PostgreSQL Row Level Security policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Canonical site base URL (e.g., http://localhost:3000 locally, https://yourdomain.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER-SIDE SECRETS (NEVER expose to browser bundle or client code)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Used strictly by server route handlers / admin provisioning)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Initial Administrator Email (For scripts/setup-admin.mjs provisioning)
ADMIN_EMAIL=your-admin-email@example.com

# ------------------------------------------------------------------------------
# NOTES:
# - Admin password is NEVER specified in environment files; handled securely
#   via interactive prompt or Supabase Auth dashboard.
# - If NEXT_PUBLIC_SUPABASE_URL is omitted locally, the app gracefully runs
#   using an in-memory DevFallbackStore for local development and UI testing.
# ==============================================================================
